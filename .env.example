INTERVIEW_DB_URL=jdbc:mysql://localhost:15006/interview?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_general_ci
INTERVIEW_DB_USERNAME=root
INTERVIEW_DB_PASSWORD=root
INTERVIEW_REDIS_HOST=localhost
INTERVIEW_REDIS_PORT=16379
INTERVIEW_MONGO_URI=mongodb://localhost:27017/interview

# 消息队列：评分 / 追问 / 报告三条异步链路的统一通道。
# 端口与账号要和 docker-compose.yml 里 rabbitmq 服务保持一致，否则启动时连不上 broker，
# 三个 @RabbitListener 会一直重连刷日志，答题后任务全部投不出去。
INTERVIEW_MQ_HOST=localhost
INTERVIEW_MQ_PORT=5672
INTERVIEW_MQ_USER=interview
INTERVIEW_MQ_PASSWORD=interview123

INTERVIEW_JWT_SECRET=replace-with-a-long-random-secret
INTERVIEW_AI_BASE_URL=https://tokenx24.com/v1
INTERVIEW_AI_API_KEY=replace-with-your-api-key
INTERVIEW_AI_MODEL=glm-5.3-flash

# 提示词（业务 Skill 规则）托管到 Nacos 配置中心
# 关掉（false）或 Nacos 连不上时，程序会用 jar 内 resources/skills/*.md 打包版本兜底，服务照常运行
INTERVIEW_SKILL_NACOS_ENABLED=true
NACOS_SERVER_ADDR=localhost:18848
NACOS_NAMESPACE=
NACOS_SKILL_GROUP=INTERVIEW_SKILL
